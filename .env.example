# Optional overrides. Reads/search need no token. For sends, follow README setup
# to issue a scoped credential; the default token file is discovered automatically.
# Never commit a token value.
# T3_TOKEN_FILE=/path/to/owner-only-token-file
# T3_ORIGIN=http://127.0.0.1:3773
# T3_DATABASE=/path/to/T3/state.sqlite
